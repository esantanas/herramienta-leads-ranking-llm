# Copia este archivo a .env y completa la API key.
GEMINI_API_KEY=

# Modelo. Cuentas NUEVAS de Google ya no tienen acceso a gemini-2.5-flash (responde 404).
#   gemini-3.8-flash  → usa GEMINI_THINKING_LEVEL (no se puede apagar el thinking)
#   gemini-2.5-flash  → solo si tu cuenta ya lo usaba; usa GEMINI_THINKING_BUDGET=0
GEMINI_MODEL=gemini-3.8-flash

# Timeout por request (ms). gemini-3.8-flash tarda 18–30 s con este prompt: 30 s no alcanza.
GEMINI_TIMEOUT_MS=120000

# Requests por minuto hacia Gemini. Free tier: 5. Clave de pago: súbelo (p. ej. 60) o déjalo vacío.
GEMINI_MAX_RPM=5

# Thinking — define SOLO UNO de los dos (juntos dan error):
#   Gemini 3.x:  low | medium | high   (low = más barato y rápido; suficiente para extraer datos)
GEMINI_THINKING_LEVEL=low
#   Gemini 2.5:  0 apaga el thinking
GEMINI_THINKING_BUDGET=

# Opcionales
# Precio por millón de tokens (si el modelo no está en la tabla de src/batch.ts o cambió)
# GEMINI_PRICE_INPUT_PER_M=0.75
# GEMINI_PRICE_OUTPUT_PER_M=3.75
# PORT=3000
# LOG_LEVEL=info
